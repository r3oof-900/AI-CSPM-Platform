# ==========================================
# AI-CSPM Platform: Git Ignore Rules
# Uploading the Tool & Dashboard ONLY
# ==========================================

# 1. Credentials & Sensitive Secrets (NEVER COMMIT)
*.pem
*.key
*.id_rsa
*.env
*.env.local

# 2. Node & Frontend Build Artifacts
node_modules/
**/node_modules/
dist/
**/dist/
.vite/
**/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 3. Python Cache & Virtual Environments
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.venv
venv/
env/
.pytest_cache/

# 4. Terraform State & Machine Cache
.terraform/
**/.terraform/
*.tfstate
*.tfstate.*
.terraform.lock.hcl

